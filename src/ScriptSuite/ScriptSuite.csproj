<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScriptSuite</AssemblyName>
    <Version>1.0.2</Version>
    <!-- NOTE: net10.0 target (security: was net8.0, EOL 2026-11-10).
         Do NOT use net8.0-desktop (Windows-only WPF/WinForms implying). -->
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Themes\*.axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.14" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.14" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.14" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.14" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.14" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <!-- Shipped assets: manifests describe scripts, default configs seed
       ~/.config/scriptsuite on first run, Bash scripts stay the source of
       truth for logic (Stage 2+). -->
  <ItemGroup>
    <None Include="Manifests\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="DefaultConfigs\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\scripts\**\*.sh" CopyToOutputDirectory="PreserveNewest"
          Link="scripts\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
