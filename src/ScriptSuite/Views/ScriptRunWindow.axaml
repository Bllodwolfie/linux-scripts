<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScriptSuite.ViewModels"
        x:Class="ScriptSuite.Views.ScriptRunWindow"
        x:DataType="vm:ScriptRunViewModel"
        Icon="avares://ScriptSuite/Assets/Cat_bobber-dark.png"
        Title="{Binding Title}"
        Width="840" Height="620" MinWidth="600" MinHeight="420"
        Background="{DynamicResource Brush.Background.Primary}"
        Foreground="{DynamicResource Brush.Foreground.Primary}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,16,24,18">
        <!-- Row 0: header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource Brush.Status.Error}"
                            CornerRadius="4" Padding="6,1"
                            IsVisible="{Binding ShowAdminBadge}"
                            VerticalAlignment="Center">
                        <TextBlock Text="ADMIN" FontSize="11"
                                   Foreground="{DynamicResource Brush.Status.Error.Foreground}" />
                    </Border>
                </StackPanel>
                <Button Content="?" Command="{Binding ToggleHelpCommand}"
                        Width="24" Height="24" HorizontalAlignment="Right"
                        DockPanel.Dock="Right" />
            </DockPanel>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.8" />
            <TextBlock Text="{Binding AdminNote}" IsVisible="{Binding ShowAdminBadge}"
                       Foreground="{DynamicResource Brush.Status.Warning.Text}"
                       FontSize="13" />
            <Border IsVisible="{Binding HelpVisible}"
                    BorderBrush="{DynamicResource Brush.Background.Card.Hover}"
                    BorderThickness="1" CornerRadius="6" Padding="10"
                    Margin="0,6,0,0">
                <TextBlock Text="{Binding HelpText}" TextWrapping="Wrap" FontSize="13" />
            </Border>
        </StackPanel>

        <!-- Row 1: preview panel / outcome banner -->
        <StackPanel Grid.Row="1" Margin="0,14,0,6">
            <StackPanel IsVisible="{Binding PreviewVisible}" Spacing="4">
                <TextBlock Text="{Binding PreviewMessage}" TextWrapping="Wrap"
                           Opacity="0.8" />
                <ListBox ItemsSource="{Binding Selections}" Height="200">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RunSelectionItem">
                            <Border BorderBrush="{DynamicResource Brush.Background.Card.Hover}"
                                    BorderThickness="1" CornerRadius="6"
                                    Background="{DynamicResource Brush.Background.Card}"
                                    Padding="8,6">
                                <StackPanel Spacing="2">
                                    <CheckBox IsChecked="{Binding IsChecked}"
                                              IsVisible="{Binding Selectable}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding ActionDisplay}"
                                                       FontWeight="SemiBold" FontSize="11" />
                                            <TextBlock Text="{Binding Target}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                IsVisible="{Binding !Selectable}">
                                        <TextBlock Text="{Binding ActionDisplay}"
                                                   FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Text="{Binding Target}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" FontSize="12"
                                               Opacity="0.7" Margin="24,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding SelectionCountText}" FontSize="13"
                           Opacity="0.7" />
                <ItemsControl ItemsSource="{Binding PreviewNotes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="monospace"
                                       FontSize="12" TextWrapping="Wrap"
                                       Opacity="0.85" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" FontSize="16"
                       FontWeight="SemiBold"
                       Classes.badge-success="{Binding IsSuccessBadge}"
                       Classes.badge-warning="{Binding IsWarningBadge}"
                       Classes.badge-error="{Binding IsErrorBadge}"
                       Classes.badge-info="{Binding IsInfoBadge}" />
        </StackPanel>

        <!-- Row 2: live log -->
        <StackPanel Grid.Row="2" Spacing="4" Margin="0,10,0,0">
            <TextBlock Text="Output" FontSize="13" FontWeight="SemiBold" />
            <ListBox ItemsSource="{Binding LogLines}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="monospace"
                                   FontSize="12" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- Row 3: footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Confirm" Command="{Binding ConfirmCommand}"
                    IsEnabled="{Binding ConfirmEnabled}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}"
                    IsVisible="{Binding CancelVisible}" />
            <Button Content="Close" Command="{Binding CloseCommand}"
                    IsEnabled="{Binding CloseEnabled}" />
        </StackPanel>
    </Grid>

</Window>
