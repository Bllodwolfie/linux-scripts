<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScriptSuite.ViewModels"
        x:Class="ScriptSuite.Views.ScheduledHistoryWindow"
        x:DataType="vm:ScheduledHistoryViewModel"
        Icon="/Assets/Cat_bobber-dark.png"
        Title="Scheduled History"
        Width="860" Height="560" MinWidth="560" MinHeight="360"
        Background="{DynamicResource Brush.Background.Primary}"
        Foreground="{DynamicResource Brush.Foreground.Primary}">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24,18,24,20">
        <DockPanel Grid.Row="0">
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Scheduled Runs" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="{Binding CountText}" Opacity="0.7"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Results are only visible here (no notifications). Skipped — app was busy is a distinct outcome, not silently dropped."
                           FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <Button Content="Close" Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right" DockPanel.Dock="Right"
                    Padding="18,8" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}"
                   IsVisible="{Binding ShowEmptyMessage}"
                   Margin="0,12,0,0" Opacity="0.7" />

        <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryRowViewModel">
                        <Border BorderBrush="{DynamicResource Brush.Background.Card.Hover}"
                                BorderThickness="1" CornerRadius="8"
                                Background="{DynamicResource Brush.Background.Card}"
                                Padding="14,10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="158,*,92">
                                <TextBlock Grid.Column="0" Text="{Binding When}"
                                           Opacity="0.7" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}"
                                               IsVisible="{Binding HasSummary}"
                                               TextWrapping="Wrap" Opacity="0.8" />
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="4"
                                        Padding="8,2"
                                        Classes.badge-success="{Binding IsSuccessBadge}"
                                        Classes.badge-warning="{Binding IsWarningBadge}"
                                        Classes.badge-error="{Binding IsErrorBadge}"
                                        Classes.badge-info="{Binding IsInfoBadge}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Outcome}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Classes.badge-success="{Binding IsSuccessBadge}"
                                               Classes.badge-warning="{Binding IsWarningBadge}"
                                               Classes.badge-error="{Binding IsErrorBadge}"
                                               Classes.badge-info="{Binding IsInfoBadge}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</Window>
