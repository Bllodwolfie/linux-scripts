<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScriptSuite.ViewModels"
        x:Class="ScriptSuite.Views.HistoryWindow"
        x:DataType="vm:HistoryViewModel"
        Title="Run History"
        Width="860" Height="560" MinWidth="560" MinHeight="360">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24,18,24,20">
        <DockPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center">
                <TextBlock Text="Run History" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="{Binding CountText}" Opacity="0.7"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="Close" Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right" DockPanel.Dock="Right"
                    Padding="18,8" />
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                    Margin="0,10,0,0">
            <TextBox Text="{Binding SearchText}" Width="260"
                     Watermark="Search script, summary, outcome…" />
            <ComboBox ItemsSource="{Binding OutcomeOptions}"
                      SelectedItem="{Binding OutcomeFilter}" Width="140" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding EmptyMessage}"
                   IsVisible="{Binding ShowEmptyMessage}"
                   Margin="0,12,0,0" Opacity="0.7" />

        <ScrollViewer Grid.Row="3" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryRowViewModel">
                        <Border BorderBrush="Gray" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="158,*,92">
                                    <TextBlock Grid.Column="0" Text="{Binding When}"
                                               Opacity="0.7" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}"
                                                   IsVisible="{Binding HasSummary}"
                                                   TextWrapping="Wrap" Opacity="0.8" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="4"
                                            Padding="8,2" Background="SlateGray"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Outcome}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            Margin="0,8,0,0">
                                    <Button Content="{Binding ExpandButtonText}"
                                            Command="{Binding ToggleCommand}" />
                                    <TextBlock Text="{Binding LogFileHint}"
                                               FontSize="11" Opacity="0.6"
                                               MaxWidth="520" TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Border IsVisible="{Binding IsExpanded}"
                                        BorderBrush="Gray" BorderThickness="1"
                                        CornerRadius="6" Padding="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Detail" FontWeight="SemiBold"
                                                   FontSize="12" />
                                        <ScrollViewer MaxHeight="180">
                                            <TextBlock Text="{Binding ExpandedDetail}"
                                                       FontFamily="monospace" FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </ScrollViewer>
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding HasLogFile}">
                                            <Button Content="Open log file"
                                                    Click="OpenLog_Click" />
                                            <Button Content="Open folder"
                                                    Click="OpenFolder_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</Window>
