<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScriptSuite.ViewModels"
        x:Class="ScriptSuite.Views.ScheduledTasksWindow"
        x:DataType="vm:ScheduledTasksViewModel"
        Icon="/Assets/Cat_bobber-dark-square.png"
        Title="Scheduled Tasks"
        Width="860" Height="580" MinWidth="580" MinHeight="380"
        Background="{DynamicResource Brush.Background.Primary}"
        Foreground="{DynamicResource Brush.Foreground.Primary}">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24,18,24,20">
        <!-- Header -->
        <DockPanel Grid.Row="0">
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Scheduled Tasks" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="{Binding CountText}" Opacity="0.7"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Overview of automated runs configured via systemd user timers. Tasks execute in the background according to their schedule."
                           FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <Button Content="Close" Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right" DockPanel.Dock="Right"
                    Padding="18,8" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}"
                   IsVisible="{Binding ShowEmptyMessage}"
                   Margin="0,16,0,8" Opacity="0.7" />

        <!-- Tasks List -->
        <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScheduledTaskRowViewModel">
                        <Border BorderBrush="{DynamicResource Brush.Background.Card.Hover}"
                                BorderThickness="1" CornerRadius="8"
                                Background="{DynamicResource Brush.Background.Card}"
                                Padding="16,12" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <!-- Left: Name, Description, Last Ran -->
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="16" FontWeight="SemiBold" />
                                        <Border CornerRadius="4" Padding="6,1"
                                                IsVisible="{Binding HasSchedule}"
                                                Classes.badge-scheduled="True"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Active Timer" FontSize="10" FontWeight="Bold"
                                                       Classes.badge-scheduled="True" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                               Opacity="0.75" TextWrapping="Wrap" />
                                    <!-- Last ran at -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                        <TextBlock Text="Last ran at:" FontSize="11" Opacity="0.6" FontWeight="Medium" />
                                        <TextBlock Text="{Binding LastRanAt}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Foreground.Secondary}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Middle: Schedule Details -->
                                <Border Grid.Column="1" Margin="0,0,16,0" Padding="12,8"
                                        Background="{DynamicResource Brush.Background.Card.Hover}"
                                        CornerRadius="6" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Schedule" FontSize="10" FontWeight="Bold"
                                                   Opacity="0.6" />
                                        <TextBlock Text="{Binding ScheduleSummary}" FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent.Primary}" />
                                    </StackPanel>
                                </Border>

                                <!-- Right: Configure button -->
                                <Button Grid.Column="2" Content="Configure"
                                        Command="{Binding EditCommand}"
                                        Padding="14,8" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
