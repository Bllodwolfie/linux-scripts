<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ScriptSuite.Controls"
        x:Class="ScriptSuite.Views.SettingsWindow"
        Title="Settings"
        Width="720" Height="640" MinWidth="560" MinHeight="400">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="24,18,24,20">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="ScriptNameText" Grid.Column="0" FontSize="22"
                       FontWeight="Bold" VerticalAlignment="Center" />
            <Button x:Name="HelpButton" Grid.Column="1" Content="?"
                    Width="22" Height="22" Margin="8,0,0,0"
                    Click="HelpButton_Click" IsVisible="False" />
        </Grid>
        <TextBlock x:Name="ScriptDescriptionText" Grid.Row="1"
                   TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.8" />

        <Border x:Name="HelpPanel" Grid.Row="2" BorderBrush="Gray"
                BorderThickness="1" CornerRadius="6" Padding="10"
                Margin="0,8,0,0" IsVisible="False">
            <TextBlock x:Name="HelpTextBlock" FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <TextBlock x:Name="NoFieldsText" Grid.Row="3" FontSize="13"
                   TextWrapping="Wrap" Margin="0,16,0,0" Opacity="0.7"
                   Text="This script has no configurable settings."
                   IsVisible="False" />

        <controls:SettingsForm x:Name="SettingsFormControl" Grid.Row="4"
                               Margin="0,12,0,0" />

        <!-- Advanced per-extension rules — DownloadsCleanup only (additive, collapsed by default). -->
        <controls:DownloadsAdvancedRulesControl x:Name="AdvancedRulesControl"
                                                Grid.Row="5" Margin="0,8,0,0"
                                                IsVisible="False" />
    </Grid>

</Window>
