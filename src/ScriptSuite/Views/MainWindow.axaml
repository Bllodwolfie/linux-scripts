<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScriptSuite.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="ScriptSuite.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ScriptSuite">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <ScrollViewer>
    <StackPanel Margin="24" Spacing="12">
        <TextBlock Text="{Binding Greeting}" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="Stage 3 — EmptyTrash end-to-end (plus Stage 2 TempCleanup). This window proves:" />
        <TextBlock Text="• Avalonia app boots on KDE Neon&#x0a;• XDG paths resolve&#x0a;• Manifests load&#x0a;• history.db initializes&#x0a;• TempCleanup.sh dry-runs, runs, and records history&#x0a;• EmptyTrash.sh enumerates real Trash via gio + trashinfo, age-filters, and records history" />
        <Border BorderBrush="Gray" BorderThickness="1" Padding="12">
            <TextBlock Text="{Binding StatusLines}" FontFamily="monospace" />
        </Border>
        <Button Content="Run self-tests (TempCleanup scratch dir; EmptyTrash real Trash, user items protected)"
                Command="{Binding RunSelfTestCommand}"
                IsEnabled="{Binding !IsSelfTestRunning}" />
        <Border BorderBrush="Gray" BorderThickness="1" Padding="12">
            <TextBlock Text="{Binding Stage2Log}" FontFamily="monospace" />
        </Border>
    </StackPanel>
    </ScrollViewer>

</Window>
