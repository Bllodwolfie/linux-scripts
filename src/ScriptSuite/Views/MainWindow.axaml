<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScriptSuite.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
        x:Class="ScriptSuite.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ScriptSuite"
        Background="{DynamicResource Brush.Background.Primary}"
        Foreground="{DynamicResource Brush.Foreground.Primary}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <ScrollViewer>
    <StackPanel Margin="24" Spacing="12">
        <DockPanel>
            <TextBlock Text="{Binding Greeting}" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="?" Command="{Binding ToggleDashboardHelpCommand}"
                        Width="24" Height="24" ToolTip.Tip="Dashboard help" />
                <Button Content="{Binding ThemeLabel}"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip.Tip="{Binding ThemeTip}" />
                <CheckBox Content="Show hidden" IsChecked="{Binding ShowHidden}"
                          VerticalAlignment="Center" />
                <Button Content="Run All" Command="{Binding OpenRunAllCommand}"
                        IsEnabled="{Binding RunAllEnabled}" />
                <Button Content="History…" Command="{Binding OpenHistoryCommand}" />
                <Button Content="Scheduled…" Command="{Binding OpenScheduledHistoryCommand}" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DockPanel>

        <Border BorderBrush="{DynamicResource Brush.Background.Card.Hover}"
                BorderThickness="1" CornerRadius="6" Padding="10"
                IsVisible="{Binding DashboardHelpVisible}">
            <TextBlock Text="{Binding DashboardHelpText}" FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Foreground.Secondary}" />
        </Border>

        <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScriptCardViewModel">
                    <Border BorderBrush="{DynamicResource Brush.Background.Card.Hover}"
                            BorderThickness="1" CornerRadius="6"
                            Background="{DynamicResource Brush.Background.Card}"
                            Padding="12" Margin="0,0,0,4"
                            IsVisible="{Binding IsVisible}"
                            Opacity="{Binding TileOpacity}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="15" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <Border Background="{DynamicResource Brush.Status.Error}"
                                        CornerRadius="4" Padding="6,1"
                                        IsVisible="{Binding RequiresAdmin}">
                                    <TextBlock Text="ADMIN" FontSize="11"
                                               Foreground="{DynamicResource Brush.Status.Error.Foreground}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}"
                                       TextWrapping="Wrap" Opacity="0.8" />
                            <TextBlock Text="{Binding ScheduleSummary}"
                                       IsVisible="{Binding HasSchedule}"
                                       Foreground="{DynamicResource Brush.Accent.Primary}"
                                       FontSize="12" />
                            <TextBlock Text="{Binding LastRunText, StringFormat='Last run: {0}'}"
                                       FontSize="12" Opacity="0.8" />
                            <TextBlock Text="{Binding RunStatus}" FontSize="12"
                                       TextWrapping="Wrap" />
                            <CheckBox Content="I understand the risks"
                                      IsChecked="{Binding RiskConsented}"
                                      IsVisible="{Binding RequiresAdmin}" />
                            <CheckBox Content="Run All"
                                      IsChecked="{Binding RunAllIncluded}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Run"
                                        Command="{Binding RunCommand}"
                                        IsEnabled="{Binding !IsRunning}" />
                                <Button Content="Schedule…"
                                        Command="{Binding OpenScheduleCommand}" />
                                <Button Content="Settings…"
                                        Command="{Binding OpenSettingsCommand}" />
                                <Button Content="Hide"
                                        Command="{Binding HideCommand}"
                                        IsVisible="{Binding !IsHidden}"
                                        IsEnabled="{Binding !IsRunning}" />
                                <Button Content="Show"
                                        Command="{Binding ShowCommand}"
                                        IsVisible="{Binding IsHidden}"
                                        IsEnabled="{Binding !IsRunning}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Recent runs" FontSize="15" FontWeight="Bold" />
        <Border BorderBrush="{DynamicResource Brush.Background.Card.Hover}"
                BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource Brush.Background.Card}"
                Padding="12">
            <ItemsControl ItemsSource="{Binding RecentRuns}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="monospace"
                                   FontSize="12" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Text="Scheduled runs" FontSize="15" FontWeight="Bold" />
        <Border BorderBrush="{DynamicResource Brush.Background.Card.Hover}"
                BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource Brush.Background.Card}"
                Padding="12">
            <ItemsControl ItemsSource="{Binding RecentScheduled}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="monospace"
                                   FontSize="12" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Button Content="Run self-tests"
                Command="{Binding RunSelfTestCommand}"
                IsEnabled="{Binding !IsSelfTestRunning}" />
        <Border BorderBrush="{DynamicResource Brush.Background.Card.Hover}"
                BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource Brush.Background.Card}"
                Padding="12">
            <TextBlock Text="{Binding Stage2Log}" FontFamily="monospace" />
        </Border>
    </StackPanel>
    </ScrollViewer>

</Window>
