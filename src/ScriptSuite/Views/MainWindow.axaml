<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScriptSuite.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
        x:Class="ScriptSuite.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Script Suite"
        Background="{DynamicResource Brush.Background.Primary}"
        Foreground="{DynamicResource Brush.Foreground.Primary}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <ScrollViewer>
    <StackPanel Margin="24,16,24,20" Spacing="0">
        <!-- Header row: title + subtitle left, help right (like Windows). -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Script Suite" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Foreground.Primary}"
                           VerticalAlignment="Center" />
                <TextBlock Text="Dashboard" FontSize="16"
                           Foreground="{DynamicResource Brush.Foreground.Tertiary}"
                           VerticalAlignment="Bottom" Margin="12,0,0,4" />
            </StackPanel>
            <Button Grid.Column="1" Content="?" Command="{Binding ToggleDashboardHelpCommand}"
                    Width="22" Height="22" FontSize="11" FontWeight="SemiBold"
                    VerticalAlignment="Center" ToolTip.Tip="Dashboard help" />
        </Grid>

        <Border BorderBrush="{DynamicResource Brush.Background.Card.Hover}"
                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0"
                IsVisible="{Binding DashboardHelpVisible}">
            <TextBlock Text="{Binding DashboardHelpText}" FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Foreground.Secondary}" />
        </Border>

        <!-- Controls row: Show hidden left; theme toggle + History/Scheduled/Run All right. -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" Content="Show hidden" IsChecked="{Binding ShowHidden}"
                      VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Button Command="{Binding ToggleThemeCommand}"
                        ToolTip.Tip="{Binding ThemeTip}"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Grid Width="22" Height="22">
                        <!-- Moon (shown in Dark): M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z -->
                        <Path Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                              Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.9"
                             
                              Fill="Transparent" Stretch="Uniform"
                              IsVisible="{Binding IsDarkTheme}" />
                        <!-- Sun (shown in Latte): circle r=5 + 8 rays -->
                        <Grid IsVisible="{Binding !IsDarkTheme}">
                            <Ellipse Width="10" Height="10" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.9"
                                     Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Line StartPoint="11,1" EndPoint="11,3.5" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" />
                            <Line StartPoint="11,18.5" EndPoint="11,21" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" />
                            <Line StartPoint="1,11" EndPoint="3.5,11" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" />
                            <Line StartPoint="18.5,11" EndPoint="21,11" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" />
                            <Line StartPoint="3.9,3.9" EndPoint="5.7,5.7" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" />
                            <Line StartPoint="16.3,16.3" EndPoint="18.1,18.1" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" />
                            <Line StartPoint="3.9,18.1" EndPoint="5.7,16.3" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" />
                            <Line StartPoint="16.3,5.7" EndPoint="18.1,3.9" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" />
                        </Grid>
                    </Grid>
                </Button>
                <Button Content="History" Command="{Binding OpenHistoryCommand}" Padding="16,8" Margin="0,0,8,0" />
                <Button Content="Scheduled" Command="{Binding OpenScheduledHistoryCommand}" Padding="16,8" Margin="0,0,8,0" />
                <Button Content="Run All" Command="{Binding OpenRunAllCommand}"
                        IsEnabled="{Binding RunAllEnabled}" FontWeight="SemiBold" Padding="20,8" />
            </StackPanel>
        </Grid>

        <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScriptCardViewModel">
                    <Border BorderBrush="{DynamicResource Brush.Background.Card.Hover}"
                            BorderThickness="1" CornerRadius="6"
                            Background="{DynamicResource Brush.Background.Card}"
                            Padding="12" Margin="0,0,0,4"
                            IsVisible="{Binding IsVisible}"
                            Opacity="{Binding TileOpacity}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="15" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <Border Background="{DynamicResource Brush.Status.Error}"
                                        CornerRadius="4" Padding="6,1"
                                        IsVisible="{Binding RequiresAdmin}">
                                    <TextBlock Text="ADMIN" FontSize="11"
                                               Foreground="{DynamicResource Brush.Status.Error.Foreground}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}"
                                       TextWrapping="Wrap" Opacity="0.8" />
                            <TextBlock Text="{Binding ScheduleSummary}"
                                       IsVisible="{Binding HasSchedule}"
                                       Foreground="{DynamicResource Brush.Accent.Primary}"
                                       FontSize="12" />
                            <TextBlock Text="{Binding LastRunText, StringFormat='Last run: {0}'}"
                                       FontSize="12" Opacity="0.8" />
                            <TextBlock Text="{Binding RunStatus}" FontSize="12"
                                       TextWrapping="Wrap" />
                            <CheckBox Content="I understand the risks"
                                      IsChecked="{Binding RiskConsented}"
                                      IsVisible="{Binding RequiresAdmin}" />
                            <CheckBox Content="Run All"
                                      IsChecked="{Binding RunAllIncluded}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Run"
                                        Command="{Binding RunCommand}"
                                        IsEnabled="{Binding !IsRunning}" />
                                <Button Content="Schedule…"
                                        Command="{Binding OpenScheduleCommand}" />
                                <Button Content="Settings…"
                                        Command="{Binding OpenSettingsCommand}" />
                                <Button Content="Hide"
                                        Command="{Binding HideCommand}"
                                        IsVisible="{Binding !IsHidden}"
                                        IsEnabled="{Binding !IsRunning}" />
                                <Button Content="Show"
                                        Command="{Binding ShowCommand}"
                                        IsVisible="{Binding IsHidden}"
                                        IsEnabled="{Binding !IsRunning}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Recent runs" FontSize="15" FontWeight="Bold" />
        <Border BorderBrush="{DynamicResource Brush.Background.Card.Hover}"
                BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource Brush.Background.Card}"
                Padding="12">
            <ItemsControl ItemsSource="{Binding RecentRuns}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="monospace"
                                   FontSize="12" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Text="Scheduled runs" FontSize="15" FontWeight="Bold" />
        <Border BorderBrush="{DynamicResource Brush.Background.Card.Hover}"
                BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource Brush.Background.Card}"
                Padding="12">
            <ItemsControl ItemsSource="{Binding RecentScheduled}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="monospace"
                                   FontSize="12" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Button Content="Run self-tests"
                Command="{Binding RunSelfTestCommand}"
                IsEnabled="{Binding !IsSelfTestRunning}" />
        <Border BorderBrush="{DynamicResource Brush.Background.Card.Hover}"
                BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource Brush.Background.Card}"
                Padding="12">
            <TextBlock Text="{Binding Stage2Log}" FontFamily="monospace" />
        </Border>
    </StackPanel>
    </ScrollViewer>

</Window>
