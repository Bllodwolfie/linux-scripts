<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Catppuccin Mocha (dark, default). Same key set as Tokens.Latte.axaml —
       ThemeManager swaps the two files at runtime; every window binds
       DynamicResource so no restart is needed. -->
  <Style>
    <Style.Resources>
      <!-- Background -->
      <SolidColorBrush x:Key="Brush.Background.Primary" Color="#FF1E1E2E" />
      <SolidColorBrush x:Key="Brush.Background.Card" Color="#FF313244" />
      <SolidColorBrush x:Key="Brush.Background.Card.Hover" Color="#FF45475A" />
      <SolidColorBrush x:Key="Brush.Background.Badge.Custom" Color="#FFC4956A" />
      <!-- Foreground -->
      <SolidColorBrush x:Key="Brush.Foreground.Primary" Color="#FFCDD6F4" />
      <SolidColorBrush x:Key="Brush.Foreground.Secondary" Color="#FFBAC2DE" />
      <SolidColorBrush x:Key="Brush.Foreground.Tertiary" Color="#FF6C7086" />
      <SolidColorBrush x:Key="Brush.Foreground.Help" Color="#FF7F849C" />
      <SolidColorBrush x:Key="Brush.Foreground.Detail" Color="#FFA6ADC8" />
      <!-- Accent -->
      <SolidColorBrush x:Key="Brush.Accent.Primary" Color="#FF89B4FA" />
      <SolidColorBrush x:Key="Brush.Accent.Primary.Foreground" Color="#FF1E1E2E" />
      <SolidColorBrush x:Key="Brush.Accent.Peach.Foreground" Color="#FF1E1E2E" />
      <!-- Status -->
      <SolidColorBrush x:Key="Brush.Status.Success" Color="#FFA6E3A1" />
      <SolidColorBrush x:Key="Brush.Status.Success.Foreground" Color="#FF1E1E2E" />
      <SolidColorBrush x:Key="Brush.Status.Warning" Color="#FFF9E2AF" />
      <SolidColorBrush x:Key="Brush.Status.Warning.Foreground" Color="#FF1E1E2E" />
      <SolidColorBrush x:Key="Brush.Status.Warning.Text" Color="#FFF9C74F" />
      <SolidColorBrush x:Key="Brush.Status.Error" Color="#FFF38BA8" />
      <SolidColorBrush x:Key="Brush.Status.Error.Foreground" Color="#FF1E1E2E" />
      <SolidColorBrush x:Key="Brush.Status.Info" Color="#FF89B4FA" />
      <SolidColorBrush x:Key="Brush.Status.Info.Foreground" Color="#FF1E1E2E" />
    </Style.Resources>
  </Style>
</Styles>
