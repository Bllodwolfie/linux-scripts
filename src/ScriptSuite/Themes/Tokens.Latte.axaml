<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Catppuccin Latte (light). Stage 1 stub. -->
  <Style>
    <Style.Resources>
      <Color x:Key="AppBackground">#EFF1F5</Color>
      <Color x:Key="AppSurface">#CCD0DA</Color>
      <Color x:Key="AppText">#4C4F69</Color>
      <Color x:Key="AppAccent">#8839EF</Color>
      <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource AppBackground}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource AppSurface}" />
      <SolidColorBrush x:Key="TextBrush" Color="{StaticResource AppText}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AppAccent}" />
    </Style.Resources>
  </Style>
</Styles>
