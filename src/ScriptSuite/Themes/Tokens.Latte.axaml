<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Catppuccin Latte (light). Same keys as Tokens.axaml (Mocha).
       Dark's two yellows (badge #F9E2AF vs inline #F9C74F) unify to #DF8E1D. -->
  <Style>
    <Style.Resources>
      <!-- Background -->
      <SolidColorBrush x:Key="Brush.Background.Primary" Color="#FFEFF1F5" />
      <SolidColorBrush x:Key="Brush.Background.Card" Color="#FFCCD0DA" />
      <SolidColorBrush x:Key="Brush.Background.Card.Hover" Color="#FFBCC0CC" />
      <SolidColorBrush x:Key="Brush.Background.Badge.Custom" Color="#FFFE640B" />
      <!-- Foreground -->
      <SolidColorBrush x:Key="Brush.Foreground.Primary" Color="#FF4C4F69" />
      <SolidColorBrush x:Key="Brush.Foreground.Secondary" Color="#FF5C5F77" />
      <SolidColorBrush x:Key="Brush.Foreground.Tertiary" Color="#FF8C8FA1" />
      <SolidColorBrush x:Key="Brush.Foreground.Help" Color="#FF9CA0B0" />
      <SolidColorBrush x:Key="Brush.Foreground.Detail" Color="#FF6C6F85" />
      <!-- Accent -->
      <SolidColorBrush x:Key="Brush.Accent.Primary" Color="#FF1E66F5" />
      <SolidColorBrush x:Key="Brush.Accent.Primary.Foreground" Color="#FFEFF1F5" />
      <SolidColorBrush x:Key="Brush.Accent.Peach.Foreground" Color="#FFEFF1F5" />
      <!-- Status: fills darkened vs Windows Latte on purpose — near-white badge
       text must stay readable on light surfaces (Windows' own Latte badges
       are near-invisible; not copied). Error/Info already contrast; Warning
       text darkened for body copy on light cards. -->
      <SolidColorBrush x:Key="Brush.Status.Success" Color="#FF2E7D32" />
      <SolidColorBrush x:Key="Brush.Status.Success.Foreground" Color="#FFEFF1F5" />
      <SolidColorBrush x:Key="Brush.Status.Warning" Color="#FF9A6200" />
      <SolidColorBrush x:Key="Brush.Status.Warning.Foreground" Color="#FFEFF1F5" />
      <SolidColorBrush x:Key="Brush.Status.Warning.Text" Color="#FF8A5A00" />
      <SolidColorBrush x:Key="Brush.Status.Error" Color="#FFD20F39" />
      <SolidColorBrush x:Key="Brush.Status.Error.Foreground" Color="#FFEFF1F5" />
      <SolidColorBrush x:Key="Brush.Status.Info" Color="#FF1E66F5" />
      <SolidColorBrush x:Key="Brush.Status.Info.Foreground" Color="#FFEFF1F5" />
    </Style.Resources>
  </Style>
</Styles>
