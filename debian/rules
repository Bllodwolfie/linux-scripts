#!/usr/bin/make -f
# dh sequencer: dotnet publishes self-contained single-file into
# debian/publish, dh_auto_install places it via debian/scriptsuite.install.
# `dpkg-buildpackage -us -uc` from the repo root produces
# ../scriptsuite_<version>_amd64.deb. No timers are enabled at install
# (see debian/scriptsuite.postinst).
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1
export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

%:
	dh $@

override_dh_auto_build:
	dotnet publish src/ScriptSuite/ScriptSuite.csproj -c Release -r linux-x64 \
		--self-contained -p:PublishSingleFile=true -p:InvariantGlobalization=true \
		-p:DebugType=none -o debian/publish
# DebugType=none: no .pdb / SourceLink ships in the .deb, so no build
# paths or usernames leak into the package.

override_dh_auto_clean:
	rm -rf debian/publish debian/scriptsuite
	dh_auto_clean

# Wayland taskbar/dock icon: the compositor resolves the app id through
# the .desktop file, so ship square cat art into the hicolor theme under
# the Icon=scriptsuite name (X11/title-bar fallback comes from the square
# .ico Window.Icon resource instead). The source art is landscape, so the
# shipped file is the ImageMagick-equivalent transparent-center pad
# (convert -background none -gravity center -extent 666x666); regenerated
# with Pillow here because this host has no ImageMagick.
override_dh_install:
	dh_install
	install -D -m644 assets/Cat_bobber-dark-square.png debian/scriptsuite/usr/share/icons/hicolor/512x512/apps/scriptsuite.png

# The self-contained .NET single-file binary must NOT be stripped: it carries
# no debuginfo dh_strip could use, and stripping risks corrupting the bundle.
# Only the plain bundled C library is stripped (lintian
# unstripped-binary-or-object). Empty dh_dwz suppresses the useless -dbgsym.
override_dh_strip:
	strip --strip-unneeded debian/scriptsuite/usr/lib/scriptsuite/libe_sqlite3.so
override_dh_dwz:
